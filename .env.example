# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Channel where the daily 7AM market report is posted
DISCORD_REPORT_CHANNEL_ID=123456789012345678

# Timezone for the daily schedule (IANA name, e.g. UTC, Europe/London, America/New_York)
SCHEDULE_TZ=UTC

# Time-of-day the daily report runs (24h HH:MM)
SCHEDULE_TIME=07:00

# Comma-separated symbols for the daily report.
# Crypto via ccxt (e.g. BTC/USDT, ETH/USDT), FX/Gold via yfinance tickers
# (EURUSD=X for Euro, GC=F for COMEX gold futures, etc.).
SYMBOLS=BTC/USDT,ETH/USDT,EURUSD=X,GBPUSD=X,USDJPY=X,GC=F

# Optional: ccxt exchange id for crypto data (kraken, okx, kucoin, ...).
# Kraken is the default because it is reliably accessible globally; Binance
# is geo-restricted from many cloud regions.
CRYPTO_EXCHANGE=kraken

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
