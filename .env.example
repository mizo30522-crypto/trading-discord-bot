# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Channel where the daily 7AM market report is posted
DISCORD_REPORT_CHANNEL_ID=123456789012345678

# Timezone for the daily schedule (IANA name, e.g. UTC, Europe/London, America/New_York)
SCHEDULE_TZ=UTC

# Time-of-day the daily report runs (24h HH:MM)
SCHEDULE_TIME=07:00

# Comma-separated symbols for the daily report.
# Crypto via ccxt (e.g. BTC/USDT, ETH/USDT), FX/Gold via yfinance tickers (EURUSD=X, GC=F, etc.)
SYMBOLS=BTC/USDT,ETH/USDT,EURUSD=X,GBPUSD=X,USDJPY=X,XAUUSD=X

# Optional: ccxt exchange id for crypto data (binance, bybit, kraken, ...)
CRYPTO_EXCHANGE=binance

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
